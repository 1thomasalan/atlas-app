{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Atlas file commands operate only inside the vault the user picked. The Rust shell restores that scope at boot, owns bounded agent leases, and stores credentials in the operating system credential manager.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "opener:default",
    "opener:allow-open-url",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.todoist.com/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://**" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
