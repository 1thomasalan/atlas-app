{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas App",
  "version": "0.1.0",
  "identifier": "app.atlas.local",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atlas App",
        "width": 1440,
        "height": 980,
        "minWidth": 1040,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4173 https://query1.finance.yahoo.com https://stooq.com https://api.open-meteo.com; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity"
  }
}
