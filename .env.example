# Required for browser/server mode.
# Use an absolute path to your private Atlas Markdown vault.
ATLAS_VAULT_PATH=/absolute/path/to/Atlas

# Optional. Defaults to 4173.
PORT=4173

# Optional. Keep browser-mode settings, secrets, and agent job leases outside the repo.
# Defaults to the ignored atlas-app/.atlas-local folder.
ATLAS_LOCAL_STATE_DIR=/absolute/path/to/private/atlas-app-state

# Optional weather chip settings.
# Leave unset to disable weather instead of using someone else's location.
ATLAS_WEATHER_LATITUDE=
ATLAS_WEATHER_LONGITUDE=
ATLAS_WEATHER_LABEL=Local
